# ── 运行时数据（含敏感信息：登录态等）──
data/

# ── D1 线上库导出备份（含真实线索数据，不入库）──
backup-*.sql
xueqiu-radar/backup-*.sql

# ── Node / 前端依赖 ──
node_modules/

# ── Wrangler（本地 D1 状态、密钥；.dev.vars 绝不入库）──
.wrangler/
.dev.vars
.dev.vars.*

# ── 构建产物 ──
dist/

# ── WorkBuddy 内部文件 ──
.workbuddy/

# ── IDE / 编辑器 ──
.idea/
.vscode/
*.swp
*.swo
*~

# ── 操作系统 ──
.DS_Store
Thumbs.db
desktop.ini

# ── Windows 保留设备名（异常产生的不可删文件，忽略以免污染 git status）──
/nul

# ── 日志 ──
*.log
