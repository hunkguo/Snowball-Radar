# ── Python ──
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
*.egg

# ── 虚拟环境 ──
venv/
.venv/
env/

# ── PyInstaller 构建产物 ──
build/
dist/
*.spec

# ── 运行时数据（含敏感信息：cookie、登录态、抓取数据）──
data/

# ── WorkBuddy 内部文件 ──
.workbuddy/

# ── IDE / 编辑器 ──
.idea/
.vscode/
*.swp
*.swo
*~

# ── 操作系统 ──
.DS_Store
Thumbs.db
desktop.ini

# ── Windows 保留设备名（异常产生的不可删文件，忽略以免污染 git status）──
/nul

# ── 日志 ──
*.log
